<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GameManaged Condition="'$(GameManaged)' == ''">F:\SteamLibrary\steamapps\common\Probably Stolen\Probably Stolen_Data\Managed</GameManaged>
  </PropertyGroup>
  <Target Name="RequireGameScannerSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameCodeDir)' == '' Or !Exists('$(GameCodeDir)/ModScanner.cs')" Text="Pass -p:GameCodeDir with the Assembly-CSharp source directory for the game build under test." />
  </Target>
  <ItemGroup>
    <Compile Include="$(GameCodeDir)/ModScanner.cs;$(GameCodeDir)/ModScanResult.cs;$(GameCodeDir)/ModScanFinding.cs;$(GameCodeDir)/ModCapability.cs" Link="Native/%(Filename)%(Extension)" />
    <Compile Include="$(GameCodeDir)/ModSteamRules.cs;$(GameCodeDir)/ModSteamUse.cs" Link="Native/%(Filename)%(Extension)" />
    <Reference Include="0Harmony"><HintPath>$(GameManaged)\0Harmony.dll</HintPath></Reference>
    <Reference Include="DseCecil"><HintPath>$(GameManaged)\DseCecil.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
