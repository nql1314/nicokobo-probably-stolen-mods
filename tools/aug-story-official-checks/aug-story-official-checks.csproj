<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><UseAppHost>false</UseAppHost><NuGetAudit>false</NuGetAudit>
    <AugSource Condition="'$(AugSource)' == ''">$(MSBuildThisFileDirectory)..\..\mods\aug-mechanical-ascension</AugSource>
    <StorySource Condition="'$(StorySource)' == ''">$(AugSource)\Integration</StorySource>
    <GameManaged Condition="'$(GameManaged)' == ''">F:\SteamLibrary\steamapps\common\Probably Stolen\Probably Stolen_Data\Managed</GameManaged>
    <ModLocalizationPackage>mechcore-protocol</ModLocalizationPackage>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/NativeLocalizationPort.cs" Link="Ports/NativeLocalizationPort.cs" />
    <Compile Include="../../mods/shared/ModText.cs" Link="ModText.cs" />
    <Compile Include="../../mods/nicokobo-forge/Services/ConversationContract.cs" Link="Forge/ConversationContract.cs" />
    <Compile Include="$(AugSource)\Domain\*.cs" Exclude="$(AugSource)\Domain\StartDefinition.cs;$(AugSource)\Domain\StatusPanelRules.cs;$(AugSource)\Domain\Grayline*.cs;$(AugSource)\Domain\ForgeMachineTarget.cs" Link="Domain\%(Filename)%(Extension)" />
    <Compile Include="$(AugSource)\AugNumbers.cs" Link="AugNumbers.cs" />
    <Compile Include="$(AugSource)\AugText.cs" Link="AugText.cs" />
    <Compile Include="../../mods/mechcore-protocol/MechcorePackage.cs" Link="MechcorePackage.cs" />
    <Compile Include="$(AugSource)\Official\JsonCompatibility.cs" Link="JsonCompatibility.cs" />
    <Compile Include="$(AugSource)\Persistence\StoryStateCodec.cs" Link="StoryStateCodec.cs" />
    <Compile Include="..\..\mods\shared\Nicokobo.Forge.Contracts\Conversations.cs" Link="OfficialStoryModels.cs" />
    <Compile Include="..\..\mods\nicokobo-forge\Services\OfficialStoryNativeChoice.cs" Link="OfficialStoryNativeChoice.cs" />
    <Compile Include="..\..\mods\shared\Nicokobo.Forge.Contracts\WindowInputCapture.cs" Link="OfficialStoryWindowInputCapture.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Import Project="../../mods/shared/Localization.targets" />
</Project>
