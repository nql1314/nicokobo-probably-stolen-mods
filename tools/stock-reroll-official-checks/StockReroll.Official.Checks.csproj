<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <ModLocalizationPackage>stock-reroll</ModLocalizationPackage>
    <CopyModLocalization>true</CopyModLocalization>
    <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\Probably Stolen</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\mods\shared\ItemGraphCleanup.cs" Link="Mod\ItemGraphCleanup.cs" />
    <Compile Include="../../mods/shared/ModText.cs" Link="Mod/ModText.cs" />
    <Compile Include="../shared/NativeLocalizationPort.cs" Link="Ports/NativeLocalizationPort.cs" />
    <Compile Include="..\..\mods\stock-reroll\*.cs" Exclude="..\..\mods\stock-reroll\StockCallbackPolicy.cs" Link="Mod\%(Filename)%(Extension)" />
    <Reference Include="DseCecil"><HintPath>$(GameDir)\Probably Stolen_Data\Managed\DseCecil.dll</HintPath></Reference>
  </ItemGroup>
  <Import Project="../../mods/shared/Localization.targets" />
</Project>
