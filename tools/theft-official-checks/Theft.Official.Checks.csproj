<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion>
    <TheftSource Condition="'$(TheftSource)' == ''">..\..\mods\definitely-stolen</TheftSource>
    <GameDir Condition="'$(GameDir)' == '' And '$(PROBABLY_STOLEN_GAME_DIR)' != ''">$(PROBABLY_STOLEN_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\Probably Stolen</GameDir>
    <GameManaged Condition="'$(GameManaged)' == ''">$(GameDir)\Probably Stolen_Data\Managed</GameManaged>
    <ModLocalizationPackage>definitely-stolen</ModLocalizationPackage>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../mods/shared/ModText.cs" Link="ModText.cs" />
    <Compile Include="../shared/NativeLocalizationPort.cs" Link="NativeLocalizationPort.cs" />
    <Compile Include="$(TheftSource)\Domain\*.cs" Link="Domain\%(Filename)%(Extension)" />
    <Compile Include="$(TheftSource)\Persistence\*.cs" Link="Persistence\%(Filename)%(Extension)" />
    <Compile Include="$(TheftSource)\UI\SceneLayout.cs" Link="UI\SceneLayout.cs" />
    <Compile Include="$(TheftSource)\UI\PortraitAnchors.cs" Link="UI\PortraitAnchors.cs" />
    <Compile Include="$(TheftSource)\Integration\Perks.cs" Link="Integration\Perks.cs" />
    <Compile Include="$(TheftSource)\Compatibility.cs" Link="Compatibility.cs" />
    <EmbeddedResource Include="$(TheftSource)\Data\catalog.json" LogicalName="DefinitelyStolen.Data.catalog.json" />
    <EmbeddedResource Include="$(TheftSource)\Assets\Scenes\standing-points.json" LogicalName="DefinitelyStolen.Assets.Scenes.standing-points.json" />
    <EmbeddedResource Include="$(TheftSource)\Assets\Portraits\foot-anchors.json" LogicalName="DefinitelyStolen.Assets.Portraits.foot-anchors.json" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="DseCecil"><HintPath>$(GameManaged)\DseCecil.dll</HintPath></Reference>
  </ItemGroup>
  <Import Project="../../mods/shared/Localization.targets" />
</Project>
