<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><Reference Include="DseCecil"><HintPath>$(GameManaged)\DseCecil.dll</HintPath></Reference></ItemGroup>
  <Target Name="RequireGameManaged" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManaged)\DseCecil.dll')" Text="Pass -p:GameManaged=&lt;current official game Managed directory&gt;." />
  </Target>
</Project>
