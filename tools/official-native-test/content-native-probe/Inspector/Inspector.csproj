<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><NuGetAudit>false</NuGetAudit>
    <GameManaged Condition="'$(GameManaged)' == ''">F:\SteamLibrary\steamapps\common\Probably Stolen\Probably Stolen_Data\Managed</GameManaged>
    <DefineConstants Condition="Exists('$(GameCodeDir)\ModSteamRules.cs')">$(DefineConstants);STEAM_SCANNER_V2</DefineConstants>
  </PropertyGroup>
  <Target Name="RequireCurrentGameScannerSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameCodeDir)' == ''" Text="Pass GameCodeDir explicitly with scanner sources exported from the game Build under test; historical scanner defaults are not accepted." />
  </Target>
  <ItemGroup>
    <Reference Include="DseCecil"><HintPath>$(GameManaged)\DseCecil.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameManaged)\0Harmony.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Compile Include="$(GameCodeDir)\ModScanner.cs;$(GameCodeDir)\ModScanResult.cs;$(GameCodeDir)\ModScanFinding.cs;$(GameCodeDir)\ModCapability.cs" Link="Native\%(Filename)%(Extension)" />
    <Compile Include="$(GameCodeDir)\ModSteamRules.cs;$(GameCodeDir)\ModSteamUse.cs" Link="Native\%(Filename)%(Extension)" Condition="Exists('$(GameCodeDir)\ModSteamRules.cs')" />
  </ItemGroup>
</Project>
